#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// ==========================================
// Windows 11 日本語配列 (JIS 106/109)
// ==========================================
// --- 日本語入力キー ---

#define JP_HANZEN       GRAVE           // 半角/全角
#define JP_KANA         INT_KANA        // カタカナ/ひらがな
#define JP_HENKAN       INT_HENKAN      // 変換
#define JP_MUHENKAN     INT_MUHENKAN    // 無変換

// --- 数字・Shift記号 ---

#define JP_DQUOTE       LS(N2)          // "
#define JP_AMPERSAND    LS(N6)          // &
#define JP_QUOTE        LS(N7)          // '
#define JP_LPAREN       LS(N8)          // (
#define JP_RPAREN       LS(N9)          // )

// --- 記号 ---

#define JP_EXCLAMATION  LS(N1)          // !
#define JP_HASH         LS(N3)          // #
#define JP_DOLLAR       LS(N4)          // $
#define JP_PERCENT      LS(N5)          // %
#define JP_EQUAL        LS(MINUS)       // =
#define JP_PLUS         LS(SEMICOLON)   // +
#define JP_ASTERISK     LS(SQT)         // *
#define JP_COLON        SQT             // :
#define JP_SEMICOLON    SEMICOLON       // ;
#define JP_AT           LBKT            // @
#define JP_CARET        EQUAL           // ^
#define JP_TILDE        LS(EQUAL)       // ~
#define JP_BACKQUOTE    LS(LBKT)        // `

// --- 括弧 ---

#define JP_LBRACKET     RBKT            // [
#define JP_RBRACKET     BSLH            // ]
#define JP_LBRACE       LS(RBKT)        // {
#define JP_RBRACE       LS(BSLH)        // }

// --- 円記号・バックスラッシュ ---

#define JP_YEN          INT_YEN         // ￥
#define JP_BACKSLASH    INT_YEN         // バックスラッシュ
#define JP_PIPE         LS(INT_YEN)     // |
#define JP_UNDERSCORE   LS(INT_RO)      // _

// ==========================================
// ここから既存のroBa設定
// ==========================================

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp LS(N2)>;
            key-positions = <33 22>;
            layers = <0>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        hankaku {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        colon {
            bindings = <&kp SQT>;
            key-positions = <22 21>;
            layers = <0>;
        };

        question {
            bindings = <&kp QUESTION>;
            key-positions = <22 42>;
            layers = <0>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <22 31>;
            layers = <0>;
        };

        greater_than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <22 32>;
            layers = <0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_ENCODER";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        scroll_encoder_h: scroll_encoder_h {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_ENCODER_H";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W     &kp E        &kp R                          &kp T                                                        &lt 3 Y      &kp U        &lt 5 I      &kp O    &kp P
&kp A             &lt 1 S   &mt LCTRL D  &mt LSHFT F                    &mt LALT G   &kp LS(LG(S))                    &kp MINUS      &mt LALT H   &mt LSHFT J  &mt LCTRL K  &kp L    &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X     &kp C        &kp V                          &kp B        &mt LGUI COLON                   &kp DEL        &lt 2 N      &lt 4 M      &kp COMMA    &kp DOT  &kp LS(N7)
&kp LCTRL         &kp LALT  &lt 1 TAB    &lt_to_layer_0 6 INT_MUHENKAN  &lt 2 SPACE  &lt_to_layer_0 3 INT_HENKAN      &kp BACKSPACE  &lt 1 ENTER                                     &kp SLASH
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        SYMBOL {
            bindings = <
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                      &kp LS(N6)     &kp LS(N7)    &kp LS(N8)    &kp LS(N9)    &kp INT_YEN
&trans      &trans      &trans      &kp LSHFT   &trans      &trans      &trans  &kp EQUAL      &kp LBKT      &kp RBKT      &kp BSLH      &kp LS(INT_YEN)
&trans      &trans      &trans      &trans      &trans      &trans      &trans  &kp LS(EQUAL)  &kp LS(LBKT)  &kp LS(RBKT)  &kp LS(BSLH)  &kp INT_RO
&trans      &trans      &trans      &trans      &trans      &trans      &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&scroll_encoder_h>;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LS(SEMICOLON)                             &kp F1   &kp F2   &kp F3   &kp F4  &kp F5
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp LS(SQT)        &kp SQT            &trans  &kp F6   &kp F7   &kp F8   &kp F9  &kp F10
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD         &kp LS(MINUS)      &trans  &kp F11  &kp F12  &kp F13  &trans  &trans
&trans                      &trans           &trans           &trans           &trans             &trans             &trans  &trans                             &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LA(LS(TAB))         &kp UP_ARROW    &kp LA(TAB)              &kp LG(UP)                        &kp LG(UP)    &kp LA(LS(TAB))   &kp UP_ARROW    &kp LA(TAB)        &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END       &trans      &trans  &trans        &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW    &trans
&kp LEFT_SHIFT  &kp LG(LC(LEFT_ARROW))  &trans          &kp LG(LC(RIGHT_ARROW))  &kp LG(DOWN)  &trans      &trans  &kp LG(DOWN)  &kp LC(LG(LEFT))  &trans          &kp LC(LG(RIGHT))  &kp LSHFT
&trans          &trans                  &trans          &trans                   &trans        &trans      &trans  &trans                                                             &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans    &trans    &trans    &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans    &trans    &trans    &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
